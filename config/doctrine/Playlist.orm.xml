<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Playlist" table="playlists">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>
        <many-to-one field="programSlot" target-entity="App\Domain\Entity\ProgramSlot">
            <join-column name="program_slot_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <field name="date" type="date_immutable"/>
        <field name="status" type="string" length="20"/>
        <one-to-many field="items" target-entity="App\Domain\Entity\PlaylistItem" mapped-by="playlist" orphan-removal="true">
            <cascade>
                <cascade-all/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>

</doctrine-mapping>
