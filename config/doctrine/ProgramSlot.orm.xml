<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\ProgramSlot" table="program_slots" repository-class="App\Infrastructure\Persistence\Doctrine\Repository\DoctrineProgramSlotRepository">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>
        <field name="dayOfWeek" type="string" length="20"/>
        <field name="label" type="string" length="255"/>
        <field name="startTime" type="time_immutable"/>
        <field name="endTime" type="time_immutable"/>
        <field name="theme" type="string" length="100"/>
        <field name="isValidated" type="boolean"/>
    </entity>

</doctrine-mapping>
